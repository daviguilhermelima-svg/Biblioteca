-- ================================================
-- 3. CONSULTAS ÚTEIS (EXEMPLOS)
-- ================================================

-- Consulta 1: Buscar livros por título ou autor
SELECT id, titulo, autor, status 
FROM livros 
WHERE titulo LIKE '%Anatomia%' OR autor LIKE '%Sobotta%';

-- Consulta 2: Listar empréstimos com alunos, série, curso e dias de atraso
SELECT 
    e.id,
    l.titulo,
    e.nome_pessoa,
    e.serie,
    e.curso,
    e.data_limite,
    DATEDIFF(CURRENT_DATE, e.data_limite) AS dias_atraso
FROM emprestimos e
JOIN livros l ON e.livro_id = l.id
WHERE e.data_devolucao IS NULL AND e.data_limite < CURRENT_DATE;

-- Consulta 3: Consultar fila de espera de um livro
SELECT posicao_fila, nome_pessoa, serie, curso, data_reserva
FROM reservas
WHERE livro_id = 'LIV-001'
ORDER BY posicao_fila ASC;