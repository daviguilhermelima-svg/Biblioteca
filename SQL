-- ================================================
-- 1. CRIAÇÃO DAS TABELAS
-- ================================================

-- Tabela de Livros (Acervo)
CREATE TABLE livros (
    id VARCHAR(10) PRIMARY KEY,
    titulo VARCHAR(255) NOT NULL,
    autor VARCHAR(255) NOT NULL,
    status VARCHAR(20) DEFAULT 'disponivel' CHECK (status IN ('disponivel', 'emprestado')),
    data_cadastro TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Tabela de Empréstimos (Com Série e Cursos: Administração, Agricultura, Desenvolvimento de Sistemas e Enfermagem)
CREATE TABLE emprestimos (
    id INT AUTO_INCREMENT PRIMARY KEY,
    livro_id VARCHAR(10) NOT NULL,
    nome_pessoa VARCHAR(255) NOT NULL,
    serie VARCHAR(20) NOT NULL, -- Ex: '1º Ano', '2º Ano', '3º Ano'
    curso VARCHAR(50) NOT NULL, -- Ex: 'Administração', 'Agricultura', 'Desenvolvimento de Sistemas', 'Enfermagem'
    data_emprestimo DATE NOT NULL,
    data_limite DATE NOT NULL,
    data_devolucao DATE NULL,
    valor_multa DECIMAL(10, 2) DEFAULT 0.00,
    multa_paga BOOLEAN DEFAULT FALSE,
    FOREIGN KEY (livro_id) REFERENCES livros(id) ON DELETE CASCADE
);

-- Tabela de Fila de Espera (Reservas)
CREATE TABLE reservas (
    id INT AUTO_INCREMENT PRIMARY KEY,
    livro_id VARCHAR(10) NOT NULL,
    nome_pessoa VARCHAR(255) NOT NULL,
    serie VARCHAR(20) NOT NULL,
    curso VARCHAR(50) NOT NULL,
    posicao_fila INT NOT NULL,
    data_reserva TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (livro_id) REFERENCES livros(id) ON DELETE CASCADE
);

